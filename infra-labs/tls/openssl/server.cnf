[req]
distinguished_name = server_dn
req_extensions = server_ext
prompt = no

[server_dn]
C = XX
ST = Local
L = Local
O = DV-Bookshop Infrastructure Lab
OU = Local Server
CN = localhost

[server_ext]
subjectAltName = @server_names
extendedKeyUsage = serverAuth
keyUsage = digitalSignature, keyEncipherment

[server_names]
DNS.1 = localhost
IP.1 = 127.0.0.1
